generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String?
  lastName     String?
  phone        String?
  role         String // ADMIN, SECTION_MANAGER, COACH
  section      String? // Renseigné si le rôle est SECTION_MANAGER, ou comma separated
  remuneration Float?   @default(0)
  actif        Boolean  @default(true)
  dateDebut    DateTime @default(now())
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  grades  Grade[]  @relation("Examiner")
  courses Course[]
}

model Member {
  id          String    @id @default(uuid())
  firstName   String
  lastName    String
  dateOfBirth DateTime?
  gender      String?
  phone       String?
  email       String?
  photoUrl    String?
  status      String    @default("ACTIF") // ACTIF, INACTIF, EN_ATTENTE
  signupDate  DateTime  @default(now())
  notes       String?
  parentName  String? // Pour les mineurs
  parentPhone String? // Pour les mineurs
  parentEmail String? // Courriel du parent pour les mineurs
  currentBelt String?   @default("BLANCHE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Infos personnelles additionnelles
  poids      Float?
  adresse    String?
  codePostal String?
  ville      String?

  // Santé
  problemeSante Boolean @default(false)
  noteSante     String? // détail si problème de santé

  // Contact d'urgence (1er répondant)
  urgenceNom  String?
  urgenceLien String?
  urgenceTel  String?

  // Contrat
  dateInscription DateTime?
  finContrat      DateTime?

  // Motif du départ, saisi au passage en INACTIF. Sert au tableau d'attrition :
  // savoir POURQUOI on perd des membres vaut plus que le taux lui-même.
  raisonDepart String?

  // Plan tarifaire
  plan               Plan? // 'MENSUEL', 'TRIMESTRIEL', 'ANNUEL'
  prixBase           Float?
  rabaisFamille      Boolean @default(false)
  membreFamilleId    String?
  rabaisCustomPct    Float?
  raisonRabaisCustom String?
  montantFinal       Float?

  // Référencement
  referePar              String?
  rabaisReferentPct      Float?
  rabaisReferentApplique Boolean @default(false)

  // Provenance (section 7 de la fiche d'inscription)
  provenance   String? // BOUCHE_A_OREILLE, RESEAUX_SOCIAUX, WEB, ECOLE, AUTRE
  refereParNom String? // nom du membre référent tel que saisi sur la fiche

  // Consentement au règlement intérieur (inscription en ligne)
  reglementVersion    String? // version du règlement acceptée
  reglementAccepteAt  DateTime? // horodatage de l'acceptation
  reglementSignataire String? // nom complet saisi comme signature

  // Autorisations de la fiche d'inscription (toutes obligatoires en ligne ;
  // un refus du droit à l'image se règle en personne, jamais via le formulaire)
  consentPhoto          Boolean @default(false) // droit à l'image (photos/vidéos promotionnelles)
  consentUrgence        Boolean @default(false) // recours aux services médicaux d'urgence
  consentCommunications Boolean @default(false) // communications par courriel (rappels, reçus, horaires)

  // Relations
  sections     MemberSection[]
  attendances  Attendance[]
  grades       Grade[]
  versements   PaymentVersement[]
  achats       VenteEquipement[]
  affiliations Affiliation[]
  evenements   EvenementInscription[]
}

model PaymentVersement {
  id                  String           @id @default(uuid())
  membreId            String
  numeroVersement     Int
  montant             Float
  datePrevue          DateTime
  datePaiement        DateTime?
  methodePaiement     MethodePaiement? // CASH, VIREMENT, CHEQUE, CARTE
  note                String?
  // Frais de retard (10 $/semaine après 1 semaine, règlement art. 6) : calculés
  // dynamiquement ; l'admin peut les exonérer au cas par cas.
  exonererFraisRetard Boolean          @default(false)
  // Frais réellement chargés, décidés par l'admin (null = compteur automatique).
  // Ex. : 4 semaines de retard = 40 $ courus, l'admin décide d'en charger 10 $.
  fraisRetardFactures Float?
  reminderSentAt      DateTime? // Anti-doublon pour les rappels de paiement automatiques
  receiptNumber       Int? // Numéro de reçu (assigné à l'envoi du reçu)
  receiptSentAt       DateTime? // Date d'envoi du reçu par courriel (anti-doublon)
  createdAt           DateTime         @default(now())

  member Member @relation(fields: [membreId], references: [id], onDelete: Cascade)
}

model MemberSection {
  id             String   @id @default(uuid())
  memberId       String
  section        String // KARATE, JUDO, NINJAS_GR1, NINJAS_GR2, TAEKWONDO, KICKBOXING, FITNESS, PRIVATE
  belt           String?  @default("Blanche")
  enrollmentDate DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, section])
}

model Course {
  id        String   @id @default(uuid())
  section   String
  startTime String // "17:00"
  endTime   String // "18:30"
  coachId   String?
  jours     String[] // ["LUN", "MER", "VEN"]
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  coach       User?        @relation(fields: [coachId], references: [id], onDelete: SetNull)
  attendances Attendance[]
}

model Attendance {
  id       String   @id @default(uuid())
  memberId String
  courseId String
  date     DateTime
  status   String   @default("PRESENT") // PRESENT, ABSENT, EXCUSED

  // Traçabilité du pointage : QUAND la saisie a eu lieu (à ne pas confondre
  // avec `date`, le jour du COURS) et QUI l'a faite. Volontairement nullables
  // et SANS valeur par défaut : les pointages antérieurs à cette traçabilité
  // n'ont pas d'historique, et les dater du jour de la migration serait
  // mensonger. Une valeur nulle se lit « inconnu ».
  pointeAt     DateTime?
  pointeParId  String?
  pointeParNom String? // dénormalisé, comme AuditLog : survit à la suppression du compte

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([memberId, courseId, date])
  @@index([courseId, date])
}

model Grade {
  id                 String   @id @default(uuid())
  memberId           String
  section            String
  ceinturePrecedente String
  ceintureMontante   String
  date               DateTime
  examinateurId      String
  note               String?
  createdAt          DateTime @default(now())

  member      Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  examinateur User   @relation("Examiner", fields: [examinateurId], references: [id])
}

model Lead {
  id          String  @id @default(uuid())
  firstName   String
  lastName    String
  gender      String?
  phone       String?
  email       String?
  sport       String // KARATE, JUDO, TAEKWONDO, KICKBOXING, PRIVATE
  requestType String // ESSAI, RAPPEL, TARIFS, AUTRE
  status      String  @default("NEW") // NEW, CONTACTED, CONVERTED, LOST

  // Attribution marketing (landing pages du site, pubs Meta…)
  source      String? // ex: "landing-karate-enfant", "meta-instant-form"
  utmSource   String?
  utmCampaign String?
  utmContent  String? // nom du créatif/de la pub
  note        String? // texte libre (ex: âge de l'enfant)

  // Lien avec la fiche d'inscription en ligne : quand une fiche correspondant
  // au prospect est reçue, on horodate et on pointe le dossier membre créé
  // (badge « Fiche reçue » dans Prospects, lien direct vers le dossier).
  ficheRecueAt DateTime?
  membreId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes LeadNote[]
}

// Fil de suivi d'un prospect : qui l'a appelé, ce qui s'est dit, quoi faire.
// Ajout SEULEMENT (jamais réécrit) : deux administrateurs qui se partagent les
// relances doivent voir l'historique complet, pas la dernière version écrasée.
model LeadNote {
  id        String   @id @default(uuid())
  leadId    String
  texte     String
  auteurId  String?
  auteurNom String? // dénormalisé comme AuditLog : survit à la suppression du compte
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model Section {
  id        String   @id @default(uuid())
  code      String   @unique // ex: "KARATE_GR1"
  label     String // ex: "Karaté Gr. 1"
  sport     String // ex: "KARATE", "JUDO", "NINJAS"
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
}

enum Plan {
  MENSUEL // hérité — le forfait mensuel n'existe plus, aucune interface ne le propose
  TRIMESTRIEL
  ANNUEL
}

enum MethodePaiement {
  CASH
  VIREMENT
  CHEQUE
  CARTE
}

model MasseSalariale {
  id        String   @id @default(uuid())
  mois      Int // 1-12
  annee     Int // 2024, 2025, 2026
  montant   Float
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mois, annee]) // un seul enregistrement par mois
}

model CoachSalaire {
  id        String   @id @default(uuid())
  nom       String
  montant   Float
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Config de base pour les charges avec hausse automatique annuelle
model DepenseConfig {
  id            String   @id @default(uuid())
  code          String   @unique // ex: "LOYER"
  label         String // ex: "Loyer"
  montantBase   Float // montant de référence (TAXES INCLUSES)
  anneeBase     Int // année du montantBase (ex: 2024)
  tauxHaussePct Float    @default(0) // ex: 2.0 pour +2%/an automatique
  // Le loyer commercial, l'électricité, la téléphonie sont taxables : leur part
  // de TPS/TVQ revient au club en crédits sur les intrants. Les assurances en
  // sont exonérées, et les salaires ne portent aucune taxe.
  taxable       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Charges mensuelles ou annuelles, fixes ou variables
model Depense {
  id         String           @id @default(uuid())
  label      String
  montant    Float // TAXES INCLUSES, comme tout montant saisi
  // Voir DepenseConfig.taxable : détermine si la part de taxe est récupérable.
  taxable    Boolean          @default(true)
  mois       Int? // 1-12 = mois précis | null = tous les mois de l'année
  annee      Int
  categorie  CategorieDepense @default(FIXE)
  note       String?
  isOverride Boolean          @default(false) // true si saisie manuelle sur config auto
  configCode String? // référence à DepenseConfig.code si override
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

enum CategorieDepense {
  FIXE
  VARIABLE
  SALARIALE
  AUTRE
}

// Journal d'audit : trace les modifications sensibles (membres, paiements…).
model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  userNom     String? // dénormalisé pour l'affichage
  action      String // CREATE, UPDATE, DELETE, PAY
  entity      String // Member, PaymentVersement…
  entityId    String?
  description String?
  createdAt   DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// Journal des rappels/alertes envoyés, pour éviter les doublons (dédup par type + refKey).
model ReminderLog {
  id          String   @id @default(uuid())
  type        String // PAIEMENT_J7, PAIEMENT_J0, PAIEMENT_RETARD, RENOUVELLEMENT, ABSENCE
  memberId    String
  versementId String?
  refKey      String // clé de déduplication (id versement, échéance, semaine…)
  sentAt      DateTime @default(now())

  @@unique([type, refKey])
  @@index([memberId])
}

// ---------- Module Inventaire ----------
// Un article = une combinaison précise (nom + taille + couleur + marque).
// coutAchat = coût de revient du club (JAMAIS montré aux parents) ;
// prixVente = prix facturé aux parents. Les deux modifiables par l'admin.
model ArticleInventaire {
  id          String   @id @default(uuid())
  nom         String // ex. « Kimono karaté », « Gants »
  categorie   String // KIMONO, GANTS, PROTEGE_TIBIAS, PROTEGE_DENTS, CEINTURE, COQUILLE, CHANDAIL, AUTRE
  discipline  String? // KARATE, JUDO, NINJAS, TOUS
  taille      String? // « 140 », « M0 », « 2 »…
  couleur     String? // « Bleue », « Blanc »…
  marque      String? // « Jukado », « Adidas »…
  coutAchat   Float? // coût de revient (interne club)
  prixVente   Float // prix de vente aux parents
  quantite    Int      @default(0) // stock actuel
  seuilAlerte Int? // stock bas : alerte visuelle
  actif       Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ventes VenteEquipement[]
}

// Vente d'équipement : trace QUI a acheté QUOI (prix de vente copié au moment
// de la vente). N'entre PAS dans les revenus de cotisations des rapports ;
// n'apparaît PAS automatiquement sur la facture annuelle (ajout manuel si voulu).
model VenteEquipement {
  id           String           @id @default(uuid())
  articleId    String
  membreId     String? // acheteur (null = vente comptoir sans dossier)
  quantite     Int              @default(1)
  prixUnitaire Float // prix de VENTE au moment de la vente
  methode      MethodePaiement?
  date         DateTime         @default(now())
  note         String?
  createdAt    DateTime         @default(now())

  article ArticleInventaire @relation(fields: [articleId], references: [id], onDelete: Restrict)
  member  Member?           @relation(fields: [membreId], references: [id], onDelete: SetNull)

  @@index([membreId])
  @@index([date])
}

// ---------- Module Affiliations & Événements ----------
// Affiliation annuelle à la fédération, par discipline, pour une SAISON
// (1er septembre → 31 août). Le montant transite vers la fédération :
// ce n'est PAS un revenu du club (exclu des rapports).
model Affiliation {
  id           String    @id @default(uuid())
  membreId     String
  discipline   String // KARATE, JUDO
  saison       String // « 2026-2027 »
  numero       String? // numéro de membre fédération
  montant      Float? // payé à la fédération (pas un revenu club)
  datePaiement DateTime?
  note         String?
  createdAt    DateTime  @default(now())

  member Member @relation(fields: [membreId], references: [id], onDelete: Cascade)

  @@unique([membreId, discipline, saison])
  @@index([saison])
}

// Événement spécial : compétition, passage de grade, autre.
// fraisInscription transite vers l'organisateur/fédération (pas un revenu club).
model Evenement {
  id               String    @id @default(uuid())
  titre            String
  type             String    @default("COMPETITION") // COMPETITION, PASSAGE_GRADE, FORMATION, FERMETURE, AUTRE
  discipline       String? // KARATE, JUDO, TOUS…
  date             DateTime
  dateFin          DateTime? // dernier jour INCLUS (compétition sur plusieurs jours, fermeture)
  horaire          String? // « 09:00 à 13:00 » si l'événement porte une heure
  lieu             String?
  fraisInscription Float?
  note             String?
  actif            Boolean   @default(true)

  // Calendrier de saison : une date importée d'une fédération arrive en
  // CALENDRIER (informative, visible au calendrier, aucune inscription).
  // Le bouton « Intégrer au module Événements » la passe à RETENU, ce qui
  // débloque inscriptions, frais et calcul d'admissibilité.
  statut    String  @default("RETENU") // CALENDRIER | RETENU
  source    String? // KARATE_QUEBEC, JUDO_QUEBEC, CEKQ… (null = saisi au club)
  sourceUid String? // UID iCal, pour ne pas réimporter deux fois

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inscriptions EvenementInscription[]

  // Deux valeurs nulles ne se heurtent jamais en Postgres : les événements
  // saisis à la main (source nulle) ne sont donc pas contraints.
  @@unique([source, sourceUid])
  @@index([date])
}

// Abonnement à un calendrier de fédération (fichier .ics public).
model CalendrierSource {
  id             String    @id @default(uuid())
  code           String    @unique // KARATE_QUEBEC, JUDO_QUEBEC, CEKQ…
  nom            String // « Karaté Québec — saison 2025/2026 »
  url            String // lien .ics d'abonnement
  discipline     String? // discipline appliquée aux événements importés
  actif          Boolean   @default(true)
  dernierSyncAt  DateTime?
  dernierSyncMsg String? // résultat de la dernière synchronisation
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model EvenementInscription {
  id          String   @id @default(uuid())
  evenementId String
  membreId    String
  fraisPaye   Boolean  @default(false) // frais remis (transitent vers la fédé)
  note        String?
  createdAt   DateTime @default(now())

  evenement Evenement @relation(fields: [evenementId], references: [id], onDelete: Cascade)
  member    Member    @relation(fields: [membreId], references: [id], onDelete: Cascade)

  @@unique([evenementId, membreId])
}

// Dépense payée de sa POCHE par un membre du personnel pour le club, avec la
// facture photographiée (OCR côté client, champs corrigeables). Suivi du
// remboursement ; au remboursement, elle peut être versée aux charges
// (Depense ponctuelle du mois) pour entrer dans le Module financier — jamais
// avant (sinon double comptage : l'argent n'est sorti du club qu'au
// remboursement).
model DepenseAdmin {
  id           String    @id @default(uuid())
  payeurId     String // compte User qui a payé
  payeurNom    String // figé : lisible même si le compte change
  fournisseur  String?
  dateFacture  DateTime // midi UTC (date-jour)
  sousTotal    Float? // avant taxes
  tps          Float?
  tvq          Float?
  total        Float // montant payé, taxes incluses
  categorie    String? // MATERIEL, ENTRETIEN, ADMINISTRATIF, EVENEMENT, AUTRE
  note         String?
  imageDataUrl String? // photo compressée (JPEG ≤ ~1400 px, data URL)
  ocrBrut      String? // texte OCR conservé pour vérification
  statut       String    @default("A_REMBOURSER") // A_REMBOURSER | REMBOURSE
  rembourseLe  DateTime?
  rembourseVia String? // COMPTANT, VIREMENT…
  depenseId    String? // charge Depense créée au remboursement (lien de cohérence)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([payeurId])
  @@index([statut])
}

// ==================== MODULE « POINTS & PARTAGE » ====================
// Système de redevabilité de l'entente entre les deux associées : chaque
// tâche a une assignée et une date limite ; les points suivent qui l'a
// RÉELLEMENT faite ; 100 % du bénéfice du trimestre se partage au prorata
// des points. Tout ce que l'app trace déjà (pointages, encaissements,
// prospects, rétention, ventes…) se compte automatiquement — voir
// src/lib/pointsAuto.ts. Toute modification ici est journalisée (AuditLog,
// entités Bareme/PlanTache/TacheRecurrente → section « Gestion du temps »).

// Le BARÈME (catalogue des tâches et leur valeur en points).
// `code` : lignes calculées automatiquement depuis les traces de l'app —
// ne pas renommer (pointsAuto s'y réfère). Les valeurs restent modifiables ;
// les points des tâches du plan sont FIGÉS au moment du « fait »
// (non-rétroactivité) ; les lignes automatiques utilisent la valeur courante.
model TachePoints {
  id         String   @id @default(uuid())
  code       String?  @unique // POINTAGE_SOIR, COURS_DONNE… (lignes automatiques)
  famille    String // ENSEIGNEMENT, COMPETITION, MEMBRES, ARGENT, DEVELOPPEMENT, LOCAL, RELATIONS_EXT, GOUVERNANCE, HORS_LISTE
  nom        String   @unique
  mode       String // FIXE | DUREE (points = valeur×durée)
  valeur     Float // points fixes OU coefficient appliqué à la durée
  supplement Float    @default(0) // ajouté par unité (ex. le +0,25 du cours donné)
  preuve     String // APP | DECL
  note       String?
  actif      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  plans       PlanTache[]
  recurrentes TacheRecurrente[]
}

// Une INSTANCE du plan : qui, quoi, pour quand. Créée à la réunion mensuelle,
// générée d'une récurrente, ou ajoutée à la volée (tout est journalisé).
model PlanTache {
  id           String    @id @default(uuid())
  tacheId      String
  dateLimite   DateTime // midi UTC (date-jour)
  assigneeId   String
  assigneeNom  String // figé : lisible même si le compte change
  quantite     Float     @default(1)
  duree        Float? // heures (tâches en mode DUREE)
  statut       String    @default("A_FAIRE") // A_FAIRE | FAIT | REPRIS | ANNULE
  faitParId    String?
  faitParNom   String?
  faitLe       DateTime? // midi UTC — c'est LUI qui rattache les points au mois/trimestre
  points       Float? // FIGÉS au moment du « fait » (le barème peut changer ensuite)
  note         String?
  recurrenteId String? // instance générée d'une récurrente (dédup à la génération)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tache      TachePoints      @relation(fields: [tacheId], references: [id])
  recurrente TacheRecurrente? @relation(fields: [recurrenteId], references: [id], onDelete: SetNull)

  @@unique([recurrenteId, dateLimite])
  @@index([statut, dateLimite])
  @@index([faitLe])
}

// Une tâche RÉCURRENTE (gabarit) : « Générer le mois » crée les instances
// datées, sans doublon. L'alternance fait tourner l'assignation entre les
// deux associées, occurrence par occurrence, ancrée sur `ancrage`.
model TacheRecurrente {
  id            String    @id @default(uuid())
  tacheId       String
  frequence     String // HEBDO | MENSUEL | TRIMESTRIEL
  jourSemaine   Int? // 0=dimanche … 6=samedi (HEBDO)
  jourMois      Int? // 1..28 (MENSUEL / TRIMESTRIEL)
  assigneeId    String? // assignation fixe (si pas d'alternance)
  assigneeNom   String?
  alternance    Boolean   @default(false)
  premierId     String? // qui prend la 1re occurrence de l'alternance
  premierNom    String?
  secondId      String?
  secondNom     String?
  ancrage       DateTime? // référence de parité de l'alternance (midi UTC)
  actif         Boolean   @default(true)
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tache TachePoints @relation(fields: [tacheId], references: [id])
  plans PlanTache[]
}

// Acompte versé à une associée en cours de trimestre (l'entente, art. 9.4) :
// déduit de sa part au règlement trimestriel ; jamais repris si déficit.
model AcompteAssocie {
  id        String   @id @default(uuid())
  userId    String
  nom       String // figé
  montant   Float
  date      DateTime // midi UTC
  note      String?
  createdAt DateTime @default(now())

  @@index([date])
}
